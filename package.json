    "serve": "python3 -m http.server --directory dist 8080"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "romcal": "3.0.0-dev.140",
    "@romcal/calendar.general-roman": "3.0.0-dev.140"
  }
}
