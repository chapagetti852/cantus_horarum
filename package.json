{
  "name": "cantus-horarum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liturgia Horarum in cantu gregoriano secundum Ordinem Cantus Officii (2015), for phone and desktop",
  "scripts": {
    "build:calendar": "node scripts/calendar/build.mjs 2025 2032",
